# Copy this file to `.env.local` (dev) and set the same vars in your host
# (e.g. Netlify) for production. The two NEXT_PUBLIC_* vars are required for
# GitHub login to work at all — without them the sign-in button errors out.

# Supabase — Dashboard → Settings → API
#   URL + anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   Service role key is server-only (bypasses RLS) — NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin — email of the single admin user (matched case-insensitively against
# the authenticated GitHub account's email). Grants /tools and /admin access.
ADMIN_EMAIL=

# GitHub — optional, for higher API rate limits during GitHub tool import.
# NOTE: GitHub OAuth login is configured in the Supabase dashboard
# (Authentication → Providers → GitHub), not via this token.
GITHUB_TOKEN=
